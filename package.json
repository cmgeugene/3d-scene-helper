{
  "name": "i2v-3d-scene-helper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=25.8.1 <26",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:companion": "tsx companion/index.ts",
    "companion:smoke": "tsx companion/smoke.ts",
    "smoke:browser-distribution": "node scripts/smoke-browser-distribution.mjs",
    "build": "tsc -b && vite build && node scripts/assert-production-bridge-absent.mjs",
    "build:browser-distribution": "npm run build && node scripts/build-browser-distribution.mjs",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "preview": "vite preview",
    "start:browser": "tsx companion/index.ts --editor-root dist",
    "test": "vitest",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:external": "playwright test",
    "check:preview-port": "node scripts/assert-port-available.mjs 127.0.0.1 4173",
    "test:e2e:preview": "npm run check:preview-port && npm run build:e2e && start-server-and-test \"npm run preview -- --host 127.0.0.1 --port 4173 --strictPort\" http-get://127.0.0.1:4173 \"npm run test:e2e:external\"",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format:check": "prettier --check package.json package-lock.json index.html tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts eslint.config.js .prettierrc.json playwright.config.ts \"companion/**/*.ts\" \"shared/**/*.ts\" \"scripts/**/*.mjs\" \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" README.md \"docs/**/*.md\""
  },
  "dependencies": {
    "@openai/codex": "0.146.0",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "openai-oauth": "^1.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.34.4",
    "three": "0.185.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "29.0.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "start-server-and-test": "3.0.11",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
